NODE_ENV=development
PORT=3333

# Deve bater com o docker-compose.yml na raiz do projeto
DATABASE_URL=postgresql://cinema_user:cinema_pass@localhost:5433/cinema_db
# Banco separado usado pelos testes (npm test apaga os dados dele a cada execução)
TEST_DATABASE_URL=postgresql://cinema_user:cinema_pass@localhost:5433/cinema_test

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mínimo de 32 caracteres — o boot falha se for menor (src/config/env.ts)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Minutos que uma reserva pendente segura as poltronas antes de expirar
RESERVATION_HOLD_MINUTES=10
# Máximo de poltronas por reserva
MAX_SEATS_PER_RESERVATION=6
